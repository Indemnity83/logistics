# Scripts
scripts/
# ...but CI scripts are part of the build and must be tracked. The directory
# itself is re-included, not the files: git cannot re-include a path whose
# parent directory is excluded.
!.github/scripts/

# Worktree tooling (air)
.air/
# Ignore .claude contents (local settings, scheduled_tasks.lock) but track the
# skills the CI review workflow checks out and runs. Listing the contents rather
# than the directory is deliberate: git cannot re-include a path whose parent
# directory is excluded.
.claude/*
!.claude/skills/
